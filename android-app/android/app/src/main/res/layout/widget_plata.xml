<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget PLATA (4x2). Cabecera azul con lo del mes; abajo dos botones grandes
  que abren el capturador ya con el tipo elegido. Solo vistas permitidas en
  RemoteViews: LinearLayout, FrameLayout, TextView, ImageView, Button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/plata_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── Cabecera azul ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/w_fondo_azul"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/plata_mes"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="ESTE MES"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#BFDBFE" />
            <TextView
                android:id="@+id/plata_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="al día"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/w_pastilla_clara"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/plata_libre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="…"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">
            <TextView
                android:id="@+id/plata_entro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ …"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#BBF7D0" />
            <TextView
                android:id="@+id/plata_salio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↓ …"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FECACA"
                android:layout_marginStart="14dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Botones ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/w_fondo_blanco_abajo"
        android:padding="10dp">
        <TextView
            android:id="@+id/plata_btn_entro"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+  Entró plata"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/w_boton_verde" />
        <TextView
            android:id="@+id/plata_btn_gaste"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="−  Gasté"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/w_boton_rojo"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
