<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de resumen. Diseño del sistema: fondo #F8FAFC, tinta #0F172A, azul #2563EB. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_fondo"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TE QUEDA LIBRE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#94A3B8" />

    <TextView
        android:id="@+id/txt_libre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="…"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginTop="1dp" />

    <TextView
        android:id="@+id/txt_detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="#64748B"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="7dp" />

    <TextView
        android:id="@+id/txt_acciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="11.5sp"
        android:textColor="#334155"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:ellipsize="end" />
</LinearLayout>
